+/* nvt_set_page(): 0xFF, addr[22:15], addr[14:7]. */
+static int
+nvt_set_page(uint32_t addr)
+{
+	const uint8_t page[3] = {0xff, (uint8_t)(addr >> 15), (uint8_t)(addr >> 7)};
+	return nvt_write(page, 3);
+}
+
+/* CTP_SPI_READ of n data bytes at the current page offset off: rx[2..] = data. */
+static int
+nvt_read(uint8_t off, uint8_t *out, unsigned n)
+{
+	uint8_t tx[64] = {(uint8_t)(off & 0x7fu)}, rx[64];
+	if (n + 2 > sizeof(rx)) {
+		return -1;
+	}
+	int err = espi_xfer(tx, rx, n + 2);
+	if (!err) {
+		memcpy(out, rx + 2, n);
+	}
+	return err;
+}
