+	if (touch >= 2 && kernel_thread_start(elish_touch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (kernel_thread_start(sweet_watch_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
