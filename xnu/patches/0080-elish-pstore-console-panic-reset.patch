+/*
+ * No PMU: PSCI does it. A panic ends here with kPEPanicDiagnosticsDone
+ * (and kPEPanicRestartCPU when it asks for a restart): warm reset after a
+ * pause, so the console log survives in pstore.
+ */
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	switch (type) {
+	case kPEPanicDiagnosticsDone:
+	case kPEPanicRestartCPU:
+	case kPEPanicRestartCPUNoCallouts:
+		sweet_pstore_reset(2);
+		break;
+	case kPERestartCPU:
+		sweet_pstore_reset(1);
+		break;
+	case kPEHaltCPU:
+		sweet_pstore_reset(0);
+		break;
+	default:
+		break;
+	}
+	return IODTPlatformExpert::haltRestart(type);
+}
