diff --git a/bsd/dev/sweet_pstore.c b/bsd/dev/sweet_pstore.c
new file mode 100644
index 0000000..668bdf0
--- /dev/null
+++ b/bsd/dev/sweet_pstore.c
@@ -0,0 +1,244 @@
+/*
+ * elish (Xiaomi Pad 5 Pro, SM8250) boot diagnostics for the SWEET kernel.
+ *
+ * - Console mirror into the Linux ramoops console zone (boot-arg
+ *   elishpstore, default 1): LineageOS reads it back after the next boot as
+ *   /sys/fs/pstore/console-ramoops-0, so every kernel line and panic
+ *   survives a warm reset. The zone (0xb0000000 + 2 MiB, persistent_ram_buffer
+ *   layout, no ECC) lies in DDR bank R0, outside the RAM xnu manages. The
+ *   shim's own log is kept: the kernel text is appended behind it.
+ * - Warm reset (PSCI SYSTEM_RESET2) at the end of a panic, after
+ *   elishpanicwait seconds (default 15) so the screen can be read, and for
+ *   every restart request; SYSTEM_OFF for halt.
+ * - bsd_init stage trace (elishtrace, default 1) and a watchdog thread:
+ *   an "alive" line every elishbeat seconds (default 30) and a panic, hence
+ *   a reset with the log saved, after elishstall seconds (default 120,
+ *   0 = off) without other console output before bsd_init is done.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/startup.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <stdarg.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+#define PSTORE_PA               0xb0000000ULL
+#define PSTORE_SIZE             0x200000ULL
+#define PSTORE_SIG              0x43474244u     /* "DBGC", Linux PERSISTENT_RAM_SIG */
+
+#define PSCI_SYSTEM_OFF         0x84000008ULL
+#define PSCI_SYSTEM_RESET       0x84000009ULL
+#define PSCI_FEATURES           0x8400000aULL
+#define PSCI_SYSTEM_RESET2      0xc4000012ULL
+
+struct pstore_buffer {
+	volatile uint32_t sig;
+	volatile uint32_t start;        /* next write offset */
+	volatile uint32_t size;         /* valid bytes */
+	volatile uint8_t data[];
+};
+
+static struct pstore_buffer *_Atomic pstore;
+static uint32_t pstore_cap;
+static uint64_t pstore_base;            /* bytes of the shim log kept in front */
+
+/* Console bytes [at, at + size) of sweet_log_append's stream; any context. */
+void sweet_pstore_append(const char *c, int size, uint64_t at);
+
+void
+sweet_pstore_append(const char *c, int size, uint64_t at)
+{
+	struct pstore_buffer *p = os_atomic_load(&pstore, acquire);
+	if (p == NULL || size <= 0) {
+		return;
+	}
+	uint64_t pos = pstore_base + at;
+	for (int i = 0; i < size; i++) {
+		p->data[(pos + (uint64_t)i) % pstore_cap] = (uint8_t)c[i];
+	}
+	uint64_t end = pos + (uint64_t)size;
+	p->start = (uint32_t)(end % pstore_cap);
+	p->size = end >= pstore_cap ? pstore_cap : (uint32_t)end;
+}
+
+__startup_func
+static void
+sweet_pstore_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("elishpstore", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	vm_offset_t va = ml_io_map((vm_offset_t)PSTORE_PA, (vm_size_t)PSTORE_SIZE);
+	if (va == 0) {
+		return;
+	}
+	struct pstore_buffer *p = (struct pstore_buffer *)va;
+	pstore_cap = (uint32_t)PSTORE_SIZE - (uint32_t)sizeof(struct pstore_buffer);
+	/* Keep a short, unwrapped log (the shim's) in front of the kernel's. */
+	pstore_base = 0;
+	if (p->sig == PSTORE_SIG && p->size == p->start && p->size < pstore_cap / 4) {
+		pstore_base = p->size;
+	} else {
+		p->start = 0;
+		p->size = 0;
+		p->sig = PSTORE_SIG;
+	}
+	/* New console bytes go straight in from here on; copy what came before. */
+	os_atomic_store(&pstore, p, release);
+	uint64_t pos = 0, total = sweet_log_position();
+	char buf[256];
+	while (pos < total) {
+		/* sweet_log_copy may skip ahead; the chunk always ends at the new pos */
+		uint32_t n = sweet_log_copy(&pos, buf, (uint32_t)MIN((uint64_t)sizeof(buf), total - pos));
+		if (n == 0) {
+			break;
+		}
+		sweet_pstore_append(buf, (int)n, pos - n);
+	}
+	printf("ELISH PSTORE: console mirrored to %#llx + %#llx (after %llu bytes of shim log)\n",
+	    PSTORE_PA, PSTORE_SIZE, pstore_base);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, sweet_pstore_init);
+
+/* SMCCC 1.0: x0 is the signed result; do not assume x1-x17 survive. */
+static int64_t
+sweet_psci(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int64_t)x0;
+}
+
+static void
+sweet_spin_seconds(uint32_t secs)
+{
+	uint64_t interval, end;
+	nanoseconds_to_absolutetime((uint64_t)secs * NSEC_PER_SEC, &interval);
+	end = mach_absolute_time() + interval;
+	while (mach_absolute_time() < end) {
+		/* plain spin: interrupts are off here and WFE may never wake */
+	}
+}
+
+/*
+ * Called by SweetPlatformExpert::haltRestart. how: 0 halt, 1 restart,
+ * 2 end of a panic. Does not return unless PSCI refuses.
+ */
+void sweet_pstore_reset(int how);
+
+void
+sweet_pstore_reset(int how)
+{
+	if (how == 2) {
+		uint32_t wait = 15;
+		PE_parse_boot_argn("elishpanicwait", &wait, sizeof(wait));
+		printf("ELISH: warm reset in %u s (log in pstore)\n", wait);
+		sweet_spin_seconds(wait);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (how == 0) {
+		sweet_psci(PSCI_SYSTEM_OFF, 0, 0, 0);
+	}
+	if (sweet_psci(PSCI_FEATURES, PSCI_SYSTEM_RESET2, 0, 0) >= 0) {
+		sweet_psci(PSCI_SYSTEM_RESET2, 0, 0, 0);       /* SYSTEM_WARM_RESET: DRAM kept */
+	}
+	sweet_psci(PSCI_SYSTEM_RESET, 0, 0, 0);
+}
+
+/* --- bsd_init stage trace and boot watchdog --- */
+static char sweet_stage_text[96] = "(before bsd_init)";
+static uint64_t _Atomic sweet_watch_own;        /* console bytes the watchdog wrote itself */
+static int sweet_trace = -1;
+
+void sweet_stage(const char *fmt, ...) __printflike(1, 2);
+
+void
+sweet_stage(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(sweet_stage_text, sizeof(sweet_stage_text), fmt, ap);
+	va_end(ap);
+	size_t n = strlen(sweet_stage_text);
+	if (n && sweet_stage_text[n - 1] == '\n') {
+		sweet_stage_text[n - 1] = 0;
+	}
+	if (sweet_trace < 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("elishtrace", &on, sizeof(on));
+		sweet_trace = on != 0;
+	}
+	if (sweet_trace) {
+		printf("ELISH STAGE %s\n", sweet_stage_text);
+	}
+}
+
+static int sweet_watch_chan;
+static bool _Atomic sweet_watch_stop;          /* never set yet; keeps the loop finite for the compiler */
+
+static void
+sweet_watch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t beat = 30, stall = 120;
+	PE_parse_boot_argn("elishbeat", &beat, sizeof(beat));
+	PE_parse_boot_argn("elishstall", &stall, sizeof(stall));
+	if (beat == 0 || beat > 600) {
+		beat = 30;
+	}
+	uint64_t t0 = mach_absolute_time(), last_out = 0, quiet_since = t0;
+	while (!os_atomic_load(&sweet_watch_stop, relaxed)) {
+		uint64_t deadline;
+		clock_interval_to_deadline(beat, NSEC_PER_SEC, &deadline);
+		assert_wait_deadline(&sweet_watch_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+
+		uint64_t now = mach_absolute_time(), ns, quiet_ns;
+		uint64_t out = sweet_log_position() - os_atomic_load(&sweet_watch_own, relaxed);
+		if (out != last_out) {
+			last_out = out;
+			quiet_since = now;
+		}
+		absolutetime_to_nanoseconds(now - t0, &ns);
+		absolutetime_to_nanoseconds(now - quiet_since, &quiet_ns);
+		bool done = strncmp(sweet_stage_text, "bsd_init: done", 14) == 0;
+		uint64_t before = sweet_log_position();
+		printf("ELISH: alive +%llus, quiet %llus, stage: %s\n", ns / NSEC_PER_SEC,
+		    quiet_ns / NSEC_PER_SEC, sweet_stage_text);
+		os_atomic_add(&sweet_watch_own, sweet_log_position() - before, relaxed);
+		if (stall && !done && quiet_ns / NSEC_PER_SEC >= stall) {
+			panic("ELISH: no console output for %llu s, last stage: %s",
+			    quiet_ns / NSEC_PER_SEC, sweet_stage_text);
+		}
+	}
+}
+
+/* From SweetPlatformExpert::start (threads and IOKit are up). */
+void sweet_watch_start(void);
+
+void
+sweet_watch_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sweet_watch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
