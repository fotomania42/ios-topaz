+	for (unsigned off = 0; off < NVT_POINT_LEN; off += 17) {
+		char line[17 * 3 + 1];
+		unsigned len = NVT_POINT_LEN - off < 17 ? NVT_POINT_LEN - off : 17;
+		for (unsigned j = 0; j < len; j++) {
+			(void)snprintf(line + j * 3u, 4, "%02x ", d[off + j]);
+		}
+		line[len * 3u] = 0;
+		printf("ELISH TOUCH: 5   %02u: %s\n", off, line);
+	}
