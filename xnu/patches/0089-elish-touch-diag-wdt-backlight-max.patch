+/*
+ * Backlight (boot-arg elishbl, default 2047 = full; > 2047 leaves ABL's
+ * level). The KTZ8866 at 0x11 on i2c@a8c000 (QUP wrapper 1 SE3) sets the
+ * LCD backlight; ABL leaves it at 0x3f1, Linux raises it to 0x709 at boot.
+ * Brightness is 11 bits: register 0x04 bits 2:0, register 0x05 bits 10:3.
+ * No clocks of that serial engine are touched: its pins (SDA gpio60, SCL
+ * gpio61, SOUTH TLMM) are borrowed as open-drain GPIOs, the latch held low
+ * and OE toggled (OE off = released, the board pull-ups lift the line),
+ * then put back exactly as they were. Only those two registers are written.
+ */
+#define BL_PIN_SDA      60u
+#define BL_PIN_SCL      61u
+#define BL_ADDR         0x11u
+
+static vm_offset_t bl_tlmm;
+static uint32_t bl_cfg[2];
+
+static void
+bl_line(unsigned line, int high)
+{
+	elish_wr(bl_tlmm, line * 0x1000u, bl_cfg[line] | (high ? 0 : 0x200u));
+	delay(5);
+}
+
+static int
+bl_get(unsigned line)
+{
+	return (int)(elish_rd(bl_tlmm, line * 0x1000u + 4u) & 1u);
+}
+
+/* SCL high, honouring clock stretching for up to ~1 ms. */
+static bool
+bl_scl_high(void)
+{
+	bl_line(1, 1);
+	for (unsigned i = 0; i < 200; i++) {
+		if (bl_get(1)) {
+			return true;
+		}
+		delay(5);
+	}
+	return false;
+}
+
+/* Clock out one byte MSB first; returns true on ACK. */
+static bool
+bl_byte(uint8_t v)
+{
+	for (int b = 7; b >= 0; b--) {
+		bl_line(0, (v >> b) & 1);
+		if (!bl_scl_high()) {
+			return false;
+		}
+		bl_line(1, 0);
+	}
+	bl_line(0, 1);
+	if (!bl_scl_high()) {
+		return false;
+	}
+	bool ack = !bl_get(0);
+	bl_line(1, 0);
+	return ack;
+}
+
+static void
+bl_stop(void)
+{
+	bl_line(0, 0);
+	(void)bl_scl_high();
+	bl_line(0, 1);
+}
+
+/* One register write: START, addr+W, reg, value, STOP. */
+static bool
+bl_write(uint8_t reg, uint8_t val)
+{
+	if (!bl_get(0) || !bl_get(1)) {
+		return false;   /* bus not idle */
+	}
+	bl_line(0, 0);          /* START: SDA falls while SCL is high */
+	bl_line(1, 0);
+	bool ok = bl_byte((uint8_t)(BL_ADDR << 1)) && bl_byte(reg) && bl_byte(val);
+	bl_stop();
+	return ok;
+}
+
+static void
+elish_backlight(void)
+{
+	uint32_t level = 2047;
+	PE_parse_boot_argn("elishbl", &level, sizeof(level));
+	if (level > 2047) {
+		printf("ELISH BL: left at the bootloader's level\n");
+		return;
+	}
+	bl_tlmm = ml_io_map((vm_offset_t)(ELISH_TLMM_SOUTH_PA + BL_PIN_SDA * 0x1000), 0x2000);
+	if (!bl_tlmm) {
+		printf("ELISH BL: map failed\n");
+		return;
+	}
+	uint32_t saved_cfg[2], saved_io[2];
+	for (unsigned i = 0; i < 2; i++) {
+		saved_cfg[i] = elish_rd(bl_tlmm, i * 0x1000u);
+		saved_io[i] = elish_rd(bl_tlmm, i * 0x1000u + 4u);
+		/* GPIO function, input, 2 mA, weak pull-up beside the board pull-ups */
+		bl_cfg[i] = (saved_cfg[i] & ~0x3ffu) | 3u;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		/* Release under the current function, preload the low latch, then switch to GPIO. */
+		elish_wr(bl_tlmm, i * 0x1000u, saved_cfg[i] & ~0x200u);
+		elish_wr(bl_tlmm, i * 0x1000u + 4u, saved_io[i] & ~2u);
+		elish_wr(bl_tlmm, i * 0x1000u, bl_cfg[i]);
+	}
+	delay(20);
+	bool idle = bl_get(0) && bl_get(1);
+	bool lo = idle && bl_write(0x04, (uint8_t)(level & 7u));
+	bool hi = lo && bl_write(0x05, (uint8_t)(level >> 3));
+	for (unsigned i = 0; i < 2; i++) {
+		elish_wr(bl_tlmm, i * 0x1000u, bl_cfg[i]);              /* released */
+		elish_wr(bl_tlmm, i * 0x1000u + 4u, saved_io[i] & 2u);  /* latch as before */
+		elish_wr(bl_tlmm, i * 0x1000u, saved_cfg[i]);
+	}
+	printf("ELISH BL: KTZ8866 brightness %u/2047 %s (bus idle %d, pins %08x %08x)\n", level,
+	    hi ? "set" : "NOT set", idle, saved_cfg[0], saved_cfg[1]);
+}
